# 백엔드 API base URL. 미설정 시 공개계와 같은 호스트를 쓴다
# (dev: Vite 프록시 /public-api, prod: https://dallyeo.cloud).
# 로컬 백엔드로 돌릴 때만 지정: VITE_API_BASE_URL=http://localhost:8080
#VITE_API_BASE_URL=
# MSW mock 사용 여부 (기본 false — 백엔드 U4/U5/U6 완료).
# 백엔드 없이 화면만 볼 때만 true. 켜면 /runs·/achievements·/users/me 가 전부 가짜 데이터가 된다.
VITE_ENABLE_MSW=false
# 강제 mock 브릿지 (브라우저 단독 개발용; 미설정 시 브릿지 부재 자동 감지)
VITE_FORCE_MOCK_BRIDGE=false
# 개발용 실 액세스 토큰 (dev 빌드에서만 읽힘).
# OAuth는 네이티브만 가능하므로, 브라우저에서 실 백엔드에 붙으려면 기기에서 발급된 토큰이 필요하다.
# 얻는 법: 실기기 로그인 → Mac Safari 웹 인스펙터 > Network > 아무 요청 > Authorization 헤더의
#          `Bearer ` 뒤 문자열 복사.
# 리빌드 없이 바꾸려면 브라우저 콘솔에서:
#   localStorage.setItem('dallyeo.dev.token', '<토큰>'); location.reload()
#VITE_DEV_ACCESS_TOKEN=

# ── Figma 추출 스크립트 (scripts/figma/*) ──
# 실제 값은 .env.local 에 넣을 것 (.gitignore `.env.*` 로 제외됨).
# PAT 발급: Figma → Settings → Security → Personal access tokens (파일 읽기 스코프)
FIGMA_TOKEN=figd_xxxxxxxxxxxxxxxxxxxxxxxx
# 파일 key = figma.com/design/<KEY>/... (미설정 시 client.mjs 기본값 사용)
FIGMA_FILE_KEY=rOWOGmdzTz81lhFOumuvnJ
